{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/*.{js,css,map,ico,svg,png,jpg,jpeg,webp,gif,woff,woff2,ttf,xml,txt,json,docx,pdf,mp4}"
    ]
  },
  "routes": [
    {
      "route": "/index.html",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    },
    {
      "route": "/*.{js,css}",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "cache-control": "public, max-age=604800"
      }
    },
    {
      "route": "/sitemap.xml",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/robots.txt",
      "headers": {
        "cache-control": "public, max-age=3600"
      }
    },
    {
      "route": "/*",
      "headers": {
        "cache-control": "no-cache, no-store, must-revalidate"
      }
    }
  ],
  "mimeTypes": {
    ".json": "application/json",
    ".webp": "image/webp",
    ".woff2": "font/woff2"
  }
}
